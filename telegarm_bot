def make_prediction(chat_id):
    if chat_id not in user_data:
        bot.send_message(chat_id, "Ошибка данных.", reply_markup=main_keyboard())
        return

    data = user_data[chat_id]['data']

    try:
        msg = bot.send_message(chat_id, "Расчет стоимости...", parse_mode='Markdown')
        message_to_delete_id = msg.message_id

        df = pd.DataFrame([{
            'brand': data.get('brand', 'Toyota'),
            'model': data.get('model', 'Camry'),
            'year': data.get('year', 2018),
            'mileage': data.get('mileage', 60),
            'engine_capacity': data.get('engine_capacity', 2.0),
            'transmission': data.get('transmission', 'Автомат'),
            'drive_type': data.get('drive_type', 'Передний'),
            'body_type': data.get('body_type', 'Седан'),
            'fuel_type': data.get('fuel_type', 'Бензин'),
            'color': data.get('color', 'Черный'),
            'condition': data.get('condition', 'Хорошее'),
            'owners_count': data.get('owners_count', 1),
            'accidents': data.get('accidents', 0)
        }])

        processed = car_preprocessor.transform(df)
        prediction = car_model.predict(processed, verbose=0)[0][0]

        final_price = adjust_prediction(prediction, data)
        result = format_prediction_result(data, final_price)

        try:
            bot.delete_message(chat_id, message_to_delete_id)
        except Exception:
            pass

        bot.send_message(chat_id, result, parse_mode='Markdown', reply_markup=main_keyboard())

    except Exception as e:
        error_msg = f"Произошла ошибка при расчете стоимости. Пожалуйста, попробуйте еще раз."
        bot.send_message(chat_id, error_msg, parse_mode='Markdown', reply_markup=main_keyboard())

    if chat_id in user_data:
        user_data.pop(chat_id, None)


def format_prediction_result(data, price):
    current_year = 2024
    age = current_year - data.get('year', current_year)

    lower_bound = round(price * 0.85)
    upper_bound = round(price * 1.15)

    result = (
        f"🚗 *Оценка стоимости*\n"
        f"📋 *Параметры:*\n"
        f"• {data.get('brand')} {data.get('model')}\n"
        f"• Год: {data.get('year')} ({age} лет)\n"
        f"• Пробег: {data.get('mileage'):.0f} тыс. км\n"
        f"• Двигатель: {data.get('engine_capacity')} л\n"
        f"• Коробка: {data.get('transmission')}\n"
        f"• Привод: {data.get('drive_type')}\n"
        f"• Состояние: {data.get('condition')}\n"
        f"• Владельцев: {data.get('owners_count')}\n"
        f"• ДТП: {'Да' if data.get('accidents') else 'Нет'}\n\n"
        f"💰 *Оценка стоимости:*\n"
        f"`{price:,.0f} руб`\n\n"
        f"📊 *Рыночный диапазон:*\n"
        f"• От: {lower_bound:,.0f} руб\n"
        f"• До: {upper_bound:,.0f} руб\n"
    )

    if data.get('accidents'):
        result += "⚠️ Автомобиль был в ДТП\n"

    if age > 10:
        result += "⚠️ Возраст автомобиля более 10 лет\n"

    if data.get('mileage') > 150:
        result += "⚠️ Большой пробег\n"

    result += "\n_Оценка является ориентировочной_"

    return result


