def adjust_prediction(prediction, data):
    brand = data.get('brand', '')
    year = data.get('year', 2020)
    mileage = data.get('mileage', 100)
    condition = data.get('condition', 'Хорошее')

    brand_coefs = {
        'Toyota': 1.1, 'Honda': 1.05, 'Ford': 1.0, 'BMW': 1.15,
        'Mercedes': 1.2, 'Audi': 1.12, 'Volkswagen': 1.03,
        'Hyundai': 0.95, 'Kia': 0.93, 'Nissan': 0.98
    }
    if brand in brand_coefs:
        prediction *= brand_coefs[brand]

    current_year = 2024
    age = current_year - year
    if age > 15:
        prediction *= 0.7
    elif age > 10:
        prediction *= 0.85
    elif age > 5:
        prediction *= 0.95

    if mileage > 200:
        prediction *= 0.8
    elif mileage > 150:
        prediction *= 0.85
    elif mileage > 100:
        prediction *= 0.9
    elif mileage > 50:
        prediction *= 0.95

    condition_coefs = {
        'Отличное': 1.1,
        'Хорошее': 1.0,
        'Удовлетворительное': 0.85,
        'Требует ремонта': 0.6
    }
    if condition in condition_coefs:
        prediction *= condition_coefs[condition]

    if data.get('accidents') == 1:
        prediction *= 0.85

    owners = data.get('owners_count', 1)
    if owners > 1:
        prediction *= (1 - (owners - 1) * 0.05)

    if prediction < 100000:
        prediction = round(prediction / 10000) * 10000
    else:
        prediction = round(prediction / 50000) * 50000

    prediction = max(prediction, 50000)
    prediction = min(prediction, 5000000)

    return prediction


